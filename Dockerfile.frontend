# =====================================================
# 价格管理系统 - 前端 Dockerfile
# 使用 Nginx 托管静态资源
# =====================================================

# ===== 阶段1：构建阶段 =====
FROM node:20-alpine AS builder

WORKDIR /app

# 复制 package.json 和依赖配置
COPY frontend/package*.json /app/

# 安装依赖
RUN npm install

# 复制源代码
COPY frontend/ /app/

# 执行构建（跳过类型检查以加快构建速度）
# 设置 API base URL（用于 Docker 环境中的 API 代理）
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# ===== 阶段2：运行阶段 =====
FROM nginx:alpine

# 删除默认 nginx 配置
RUN rm -rf /usr/share/nginx/html/*

# 从构建阶段复制构建产物
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制自定义 nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80 443 32080 32801

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
