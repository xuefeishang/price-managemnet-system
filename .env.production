# =====================================================
# 价格管理系统 - Docker 环境配置
# =====================================================

# 数据库配置（使用服务器上的MySQL 8.0）
DB_HOST=10.7.5.175
DB_PORT=3306
DB_NAME=price_management
DB_USERNAME=root
DB_PASSWORD=Root@2026

# Redis配置
REDIS_HOST=10.7.5.175
REDIS_PORT=6379
REDIS_PASSWORD=123abc

# 安全配置
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=price-management-system-secret-key-2024-production
DEFAULT_USER_PASSWORD=admin123
RESET_PASSWORD_ON_STARTUP=false

# 外部 API Key 配置
# 生产环境必须使用安全随机值，不能使用开发示例值
API_KEY_ENCRYPTION_KEY=
API_KEY_ENCRYPTION_KEY_VERSION=v1

# Java配置
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
