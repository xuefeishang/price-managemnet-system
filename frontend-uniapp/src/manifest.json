{
  "name": "矿产品价格管理系统",
  "appid": "__UNI__PRICE_MGMT",
  "description": "企业价格展示与管理平台",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,

  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>"
        ]
      },
      "ios": {}
    }
  },

  "mp-weixin": {
    "appid": "wx000000000000",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": false
    },
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于获取位置信息"
      }
    }
  },

  "mp-alipay": {
    "usingComponents": true
  },

  "mp-baidu": {
    "usingComponents": true
  },

  "mp-toutiao": {
    "usingComponents": true
  },

  "uniStatistics": {
    "enable": false
  },

  "h5": {
    "title": "矿产品价格管理系统",
    "router": {
      "mode": "history",
      "base": "/"
    },
    "devServer": {
      "port": 5174,
      "proxy": {
        "/api": {
          "target": "http://localhost:8080",
          "changeOrigin": true,
          "secure": false
        }
      }
    }
  },

  "vueVersion": "3"
}
